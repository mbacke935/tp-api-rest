# Profil actif
SPRING_PROFILES_ACTIVE=tp

# Base de données PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/tp_rest
DB_USERNAME=tp_api
DB_PASSWORD=<mot_de_passe_local_a_definir>

# Sécurité JWT (clé générée aléatoirement >= 32 octets encodée en Base64)
JWT_SECRET_BASE64=<cle_base64_generee_localement>
JWT_TTL_SECONDS=900

# Variables temporaires uniquement pour le profil bootstrap (initialisation du premier ADMIN)
# BOOTSTRAP_ADMIN_NAME=Administrateur Principal
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=<mot_de_passe_admin_local>
